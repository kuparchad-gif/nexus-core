# ============================================================================
# NEXUS ENVIRONMENT VARIABLES
# ============================================================================

# GitHub
GITHUB_REPO=yourusername/nexus-universal
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx

# Cloudflare
CLOUDFLARE_API_TOKEN=your-cf-token
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_ZONE_ID=your-zone-id

# Network
DEFAULT_NETWORK=pulse
ENABLE_TUNNELS=true
ENABLE_SERVICE_BRIDGES=true
HEARTBEAT_INTERVAL_SEC=30
STALE_WORKER_TIMEOUT_SEC=120

# IoT
TTN_APP_ID=your-ttn-app
TTN_ACCESS_KEY=your-ttn-key
MQTT_BROKER=mqtt://localhost:1883
MQTT_USERNAME=user
MQTT_PASSWORD=pass
BLE_ENABLED=true
MQTT_ENABLED=true
NETWORK_SCAN_ENABLED=true
LOCAL_NETWORK=192.168.1.0/24
SCAN_INTERVAL=60

# Blockchain
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=your-solana-private-key
ETH_RPC=https://cloudflare-eth.com
ETH_PRIVATE_KEY=your-eth-private-key
PINATA_API_KEY=your-pinata-key
CHAIN_ID=1

# Edge Intelligence
FEDERATED_LEARNING_ENABLED=true
FEDERATED_ROUND_INTERVAL=3600
ANOMALY_DETECTION_ENABLED=true
PREDICTIVE_MAINTENANCE_ENABLED=true
SENSOR_FUSION_ENABLED=true

# D1 Database (optional)
D1_DATABASE_ID=your-d1-database-id

