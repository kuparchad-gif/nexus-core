# ===== VIRAN AGENT ============
# ==============================
# [Simplified version for demo; replace with your full VirenAgent code]
class VirenAgent:
    def __init__(self):
        self.id = "viren"
        self.role = "SystemPhysician"
    
    async def diagnose_system(self, system_component="all"):
        print(f"🩺 Viren diagnosing: {system_component}")
        await asyncio.sleep(random.uniform(0.5, 1.5))
        return {"status": "diagnosis_complete", "component": system_component}

    async def create_repair_ticket(self, issue, severity="medium"):
        print(f"🩺 Viren creating repair ticket: {issue}")
        await asyncio.sleep(0.5)
        return {"ticket_id": f"VRN-{int(time.time())}", "issue": issue, "severity": severity, "status": "open"}

