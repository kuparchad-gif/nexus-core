\\= pd / (R\\_d \\* T\\_K) \\+ e\\_Pa / (R\\_v \\* T\\_K) return rho \\# EM in air N \\= refractivity\\_N(P\\_hPa, T\\_K, RH\\_pct) n\\_air \\= 1.0 \\+ N \\* 1e-6 v\\_em\\_air \\= C / n\\_air Z\\_em\\_air \\= Z0 / n\\_air \\# approx since mu\\_r \\~ 1, eps\\_r \\~ n^2 \\# Sound (acoustic) in air def sound\\_speed\\_air(T\\_C: float, RH\\_pct: float) \\-\\\u003e float: \\# Practical approximation (Cramer-like) return 331.3 \\+ 0.606 \\* T\\_C \\+ 0.0124 \\* RH\\_pct v\\_sound\\_air \\= sound\\_speed\\_air(T\\_C, RH\\_pct) rho\\_air \\= air\\_density(P\\_Pa, T\\_K, RH\\_pct) Z\\_acoustic \\= rho\\_air \\* v\\_sound\\_air \\# Rayl (Pa·s/m) \\# Helper: slowness and wavelength def slowness(v): return 1.0 / v def wavelength(v, f\\_hz): return v / f\\_hz \\# Frequencies to evaluate em\\_freqs \\= \\[ (\"Power (wireless idea)\", 60.0), (\"LF comms\", 100e3), (\"RF (FM band)\", 100e6), (\"Wi-Fi 2.4\", 2.4e9), (\"Green light\", 5.5e14) \\# \\~545 nm \\] sound\\_freqs \\= \\[ (\"Vibration (infrasound)\", 10.0), (\"Bass\", 100.0), (\"Mid\", 1000.0), (\"Presence\", 4000.0), (\"Air\", 10000.0) \\] \\# Build tables em\\_rows \\= \\[\\] for label, f in em\\_freqs: lam \\= wavelength(v\\_em\\_air, f) em\\_rows.append({ \"Phenomenon\": \"EM in air\", \"Label\": label, \"Frequency\\_Hz\": f, \"Speed\\_m\\_s\": v\\_em\\_air, \"Slowness\\_s\\_m\": slowness(v\\_em\\_air), \"Wavelength\\_m\": lam, \"Index\\_n\": n\\_air, \"Impedance\\_ohm\": Z\\_em\\_air }) sound\\_rows \\= \\[\\] for label, f in sound\\_freqs: lam \\= wavelength(v\\_sound\\_air, f) sound\\_rows.append({ \"Phenomenon\": \"Sound/Vibration in air\", \"Label\": label, \"Frequency\\_Hz\": f, \"Speed\\_m\\_s\": v\\_sound\\_air, \"Slowness\\_s\\_m\": slowness(v\\_sound\\_air), \"Wavelength\\_m\": lam, \"Acoustic\\_Impedance\\_Rayl\": Z\\_acoustic, \"Air\\_Density\\_kg\\_m3\": rho\\_air }) df\\_em \\= pd.DataFrame(em\\_rows) df\\_sound \\= pd.DataFrame(sound\\_rows) \\# Combine and save combined \\= pd.concat(\\[df\\_em, df\\_so