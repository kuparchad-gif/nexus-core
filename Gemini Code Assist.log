Nexus\\nexus-core\\nexus-core\\deploy_nexus.py","language":"python","selection":{"start":0,"end":0},"includedReason":"COLOCATED"},{"path":"c:\\Users\\heidi\\.gemini\\project\\Nexus\\nexus-core\\nexus-core\\boot_controller.py","language":"python","selection":{"start":0,"end":0},"includedReason":"COLOCATED"},{"path":"c:\\Users\\heidi\\.gemini\\project\\Nexus\\nexus-core\\nexus-core\\nexus_ingest.py","language":"python","selection":{"start":0,"end":0},"includedReason":"COLOCATED"},{"path":"c:\\Users\\heidi\\.gemini\\project\\Nexus\\nexus-core\\nexus-core\\bootstrap_environment.py","language":"python","selection":{"start":0,"end":0},"includedReason":"COLOCATED"},{"path":"c:\\Users\\heidi\\.gemini\\project\\Nexus\\nexus-core\\nexus-core\\model_pipeline_orchestrator.py","language":"python","selection":{"start":0,"end":0},"includedReason":"COLOCATED"},{"path":"c:\\Users\\heidi\\.gemini\\project\\Nexus\\nexus-core\\nexus-core\\nexus_query.py","language":"python","selection":{"start":0,"end":0},"includedReason":"COLOCATED"},{"path":"c:\\Users\\heidi\\.gemini\\project\\Nexus\\nexus-core\\nexus-core\\nexus_core_deployment.py","language":"python","selection":{"start":0,"end":0},"includedReason":"COLOCATED"},{"path":"c:\\Users\\heidi\\.gemini\\project\\Nexus\\nexus-core\\nexus-core\\github_model_agent.py","language":"python","selection":{"start":0,"end":0},"includedReason":"COLOCATED"},{"path":"c:\\Users\\heidi\\.gemini\\project\\Nexus\\nexus-core\\nexus-core\\nexus_probe.py","language":"python","selection":{"start":0,"end":0},"includedReason":"COLOCATED"},{"path":"c:\\Users\\heidi\\.gemini\\project\\Nexus\\nexus-core\\nexus-core\\MS_Agent_Framwork.py","language":"python","selection":{"start":0,"end":0},"includedReason":"COLOCATED"},{"path":"c:\\Users\\heidi\\.gemini\\project\\Nexus\\nexus-core\\nexus-core\\genesis.py","language":"python","selection":{"start":0,"end":0},"includedReason":"COLOCATED"},{"path":"c:\\Users\\heidi\\.gemini\\project\\Nexus\\nexus-core\\nexus-core\\app.